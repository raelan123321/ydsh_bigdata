# ---- 大模型接入配置模板：复制为 .env 后填入真实值，.env 不提交仓库 ----
# 兼容 OpenAI 协议的任意厂商（DeepSeek / 通义千问 DashScope / 智谱 / 本地 vLLM）

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 备选：通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Hive 连接
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=hive

# 生成 SQL 的执行上限（防止误查全表）
MAX_ROWS=200
