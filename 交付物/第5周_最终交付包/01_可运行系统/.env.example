# 第 4 周密钥管理模板：复制为 .env 后填写真实值，.env 不入库（见 .gitignore）
# 用法：cp .env.example .env  然后编辑 .env

# MySQL root 密码（metastore 元数据库）
MYSQL_ROOT_PASSWORD=root

# Hive 连 MySQL metastore 的密码
HIVE_DB_PASSWORD=hive

# Superset 加密密钥（生产环境必须替换为随机串：python -c "import secrets; print(secrets.token_hex(32))"）
SUPERSET_SECRET_KEY=please_change_this_secret

# ClickHouse 密码
CLICKHOUSE_PASSWORD=clickhouse

# LLM API Key（NL2SQL 大模型链路；留空则自动走规则兜底）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
